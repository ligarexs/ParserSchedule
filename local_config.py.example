SPREADSHEET_ID = "впишите_сюда_id_таблицы"

# путь к скачанному JSON-ключу сервисного аккаунта (см. README, раздел
# "Доступ к Google Sheets")
SERVICE_ACCOUNT_FILE = "service_account.json"
